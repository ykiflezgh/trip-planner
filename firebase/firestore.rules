rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function trip(tripId) { return get(/databases/$(db)/documents/trips/$(tripId)); }
    function isMember(t)  { return request.auth != null && request.auth.uid in t.data.memberIds; }
    function role(t)      { return t.data.roles[request.auth.uid]; }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read:   if isMember(resource);
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(resource) && role(resource) == 'owner';
      allow delete: if isMember(resource) && role(resource) == 'owner';

      match /stops/{stopId} {
        allow read:  if isMember(trip(tripId));
        allow write: if role(trip(tripId)) in ['owner', 'editor'];
      }
      match /activity/{id} { allow read: if isMember(trip(tripId)); allow write: if false; }
      match /travel/{id}   { allow read: if isMember(trip(tripId)); allow write: if false; }
    }

    match /invites/{code}   { allow read, write: if false; }
    match /placesCache/{id} { allow read, write: if false; }
  }
}
