# Copy to .env.local (gitignored). `firebase apps:sdkconfig WEB` prints the values.
VITE_FIREBASE_CONFIG={"appId":"…","apiKey":"…","projectId":"…","authDomain":"<hosting domain, e.g. tripplanner-dev-fe0a4.web.app, not firebaseapp.com>","messagingSenderId":"…"}
VITE_APP_LINK_HOST=
VITE_MAPS_API_KEY=
# Firebase console > Cloud Messaging > Web Push certificates (key pair); leave empty to hide browser notifications
VITE_FCM_VAPID_KEY=
