# Vite mode "e2e" (playwright.config.ts). Mode files override .env.local, so the developer's real
# Firebase/Maps/VAPID/Sentry values never reach a test run. The emulators accept any API key.
VITE_USE_EMULATORS=1
VITE_FIREBASE_CONFIG={"appId":"1:0:web:e2e","apiKey":"emulator","projectId":"demo-tripplanner","authDomain":"localhost","messagingSenderId":"0"}
VITE_APP_LINK_HOST=localhost:5174
VITE_MAPS_API_KEY=
VITE_FCM_VAPID_KEY=
VITE_SENTRY_DSN=
